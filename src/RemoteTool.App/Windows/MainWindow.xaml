<Window Icon="/Assets/RemoteTool.ico" x:Class="RemoteTool.App.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:RemoteTool.App.Localization"
        Title="{loc:T App_Title}" Width="780" Height="660" MinWidth="660" MinHeight="560" WindowStartupLocation="CenterScreen">
  <Grid Margin="24,18,24,18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Your address -->
    <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrushX}" BorderThickness="1" CornerRadius="8" Padding="22,16">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="{loc:T Main_YourAddress}" Foreground="{DynamicResource MutedBrush}" />
          <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
            <TextBlock x:Name="IdText" FontSize="38" FontWeight="SemiBold" FontFamily="Consolas" Foreground="{DynamicResource AccentBrush}" FlowDirection="LeftToRight" VerticalAlignment="Center" />
            <Button x:Name="CopyIdButton" Content="{loc:T Copy}" Margin="18,0,0,0" VerticalAlignment="Center" Click="CopyId_Click" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="Gray" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource MutedBrush}" />
          </StackPanel>
          <TextBlock Text="{loc:T Main_Share}" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>
        <Button x:Name="SettingsButton" Grid.Column="1" Content="{loc:T Settings}" VerticalAlignment="Top" Margin="12,0,0,0" Click="Settings_Click" />
      </Grid>
    </Border>

    <!-- Remote address -->
    <Border Grid.Row="1" Margin="0,14,0,0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrushX}" BorderThickness="1" CornerRadius="8" Padding="22,16">
      <StackPanel>
        <TextBlock Text="{loc:T Main_RemoteAddress}" Foreground="{DynamicResource MutedBrush}" />
        <Grid Margin="0,4,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox x:Name="TargetBox" FontSize="24" FontFamily="Consolas" FlowDirection="LeftToRight" />
          <Button x:Name="ConnectButton" Grid.Column="1" Content="{loc:T Connect_Button}" Style="{StaticResource PrimaryButton}" IsDefault="True" Margin="10,0,0,0" Padding="26,8" Click="Connect_Click" />
          <Button x:Name="CancelButton" Grid.Column="1" Content="{loc:T Cancel}" Visibility="Collapsed" Margin="10,0,0,0" Padding="26,8" Click="Cancel_Click" />
        </Grid>
        <TextBlock x:Name="ConnectStatus" Margin="0,8,0,0" TextWrapping="Wrap" />
        <Expander x:Name="PasswordExpander" Header="{loc:T AccessPw_Header}" Margin="0,8,0,0" Foreground="{DynamicResource MutedBrush}">
          <PasswordBox x:Name="ConnectPasswordBox" FontSize="16" FontFamily="Consolas" MaxLength="32" FlowDirection="LeftToRight" Margin="0,6,0,0" />
        </Expander>
      </StackPanel>
    </Border>

    <!-- Recent / address book / this network -->
    <TabControl Grid.Row="2" Margin="0,14,0,0">
      <TabItem Header="{loc:T Tab_Recent}">
        <ListBox x:Name="RecentList" Margin="0,10,0,0" MouseDoubleClick="Recent_DoubleClick" />
      </TabItem>
      <TabItem Header="{loc:T Tab_Address}">
        <Grid Margin="0,10,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <ListBox x:Name="AddressList" MouseDoubleClick="Address_DoubleClick" />
          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
            <TextBox x:Name="NicknameBox" Width="210" MaxLength="64" ToolTip="{loc:T Addr_Nickname}" />
            <Button Content="{loc:T Addr_Save}" Margin="8,0,8,0" Click="AddrSave_Click" />
            <Button Content="{loc:T Addr_Remove}" Click="AddrRemove_Click" />
          </StackPanel>
        </Grid>
      </TabItem>
      <TabItem Header="{loc:T Tab_Network}">
        <Grid Margin="0,10,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal">
            <Button x:Name="LanFindButton" Content="{loc:T Lan_Find}" Click="LanFind_Click" />
            <TextBlock x:Name="LanStatus" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
          </StackPanel>
          <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBox x:Name="ScanRangeBox" FlowDirection="LeftToRight" ToolTip="{loc:T Scan_Hint}" />
            <Button x:Name="ScanButton" Grid.Column="1" Content="{loc:T Scan_Button}" Margin="8,0,0,0" Click="Scan_Click" />
          </Grid>
          <TextBlock x:Name="ScanStatus" Grid.Row="2" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
          <ListBox x:Name="LanList" Grid.Row="3" Margin="0,8,0,0" MouseDoubleClick="LanList_DoubleClick" />
        </Grid>
      </TabItem>
    </TabControl>

    <!-- Organization branding (set at build time) -->
    <Grid Grid.Row="3" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Image x:Name="BrandLogo" Height="28" Margin="0,0,10,0" Visibility="Collapsed" />
      <TextBlock x:Name="BrandOrgText" Grid.Column="1" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      <TextBlock x:Name="BrandDevText" Grid.Column="2" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center" />
    </Grid>
  </Grid>
</Window>
