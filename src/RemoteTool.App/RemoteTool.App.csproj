<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>RemoteTool.App</RootNamespace>
    <AssemblyName>RemoteTool</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en;ar</SatelliteResourceLanguages>
    <ApplicationIcon>Assets\RemoteTool.ico</ApplicationIcon>
    <StartupObject>RemoteTool.App.Program</StartupObject>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Product>RemoteTool</Product>
    <Company>In-house IT</Company>
  </PropertyGroup>
  <!--
    Company defaults built into the exe so users never configure a relay. Supply at build time (all optional), e.g.
        dotnet build -p:DefaultRelayAddress=relay.corp.example:443 -p:DefaultRelayFingerprint=AABB... -p:DefaultRelayKey=...
    or through the environment variables RT_DEFAULT_RELAY / RT_DEFAULT_RELAY_FP / RT_DEFAULT_RELAY_KEY (CI secrets).
    Values are embedded as JSON strings. The access key inside an exe can be extracted: it only keeps outsiders off your relay.
  -->
  <PropertyGroup>
    <DefaultRelayAddress Condition="'$(DefaultRelayAddress)' == ''">$(RT_DEFAULT_RELAY)</DefaultRelayAddress>
    <DefaultRelayFingerprint Condition="'$(DefaultRelayFingerprint)' == ''">$(RT_DEFAULT_RELAY_FP)</DefaultRelayFingerprint>
    <DefaultRelayKey Condition="'$(DefaultRelayKey)' == ''">$(RT_DEFAULT_RELAY_KEY)</DefaultRelayKey>
  </PropertyGroup>
  <Target Name="GenerateEmbeddedDefaults" BeforeTargets="AssignTargetPaths">
    <PropertyGroup>
      <_DefaultsFile>$(IntermediateOutputPath)defaults.json</_DefaultsFile>
      <!-- JSON-escape (backslash, quote); MSBuild has no UTF8 property function, so values are embedded as plain escaped JSON strings -->
      <_Relay>$(DefaultRelayAddress.Replace('\', '\\').Replace('"', '\"').Replace(';', '%3B'))</_Relay>
      <_Fp>$(DefaultRelayFingerprint.Replace('\', '\\').Replace('"', '\"').Replace(';', '%3B'))</_Fp>
      <_Key>$(DefaultRelayKey.Replace('\', '\\').Replace('"', '\"').Replace(';', '%3B'))</_Key>
    </PropertyGroup>
    <WriteLinesToFile File="$(_DefaultsFile)" Overwrite="true" Lines="{&quot;relay&quot;:&quot;$(_Relay)&quot;,&quot;fingerprint&quot;:&quot;$(_Fp)&quot;,&quot;accessKey&quot;:&quot;$(_Key)&quot;}" />
    <ItemGroup>
      <EmbeddedResource Include="$(_DefaultsFile)" LogicalName="RemoteTool.defaults.json" />
    </ItemGroup>
  </Target>

  <!--
    Per-organization branding (name, logo, concurrent users, developer). BrandingDir holds branding.json (+ optional logo.png); scripts/build-wizard.ps1 creates it.
        dotnet publish -p:BrandingDir=C:\path\to\branding\acme
  -->
  <PropertyGroup>
    <BrandingDir Condition="'$(BrandingDir)' == ''">$(RT_BRANDING_DIR)</BrandingDir>
  </PropertyGroup>
  <ItemGroup Condition="'$(BrandingDir)' != '' And Exists('$(BrandingDir)\branding.json')">
    <EmbeddedResource Include="$(BrandingDir)\branding.json" LogicalName="RemoteTool.branding.json" />
  </ItemGroup>
  <ItemGroup Condition="'$(BrandingDir)' != '' And Exists('$(BrandingDir)\logo.png')">
    <EmbeddedResource Include="$(BrandingDir)\logo.png" LogicalName="RemoteTool.logo.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- The WPF SDK omits System.IO from implicit usings (Path clashes with System.Windows.Shapes.Path); this project never imports Shapes. -->
    <Using Include="System.IO" />
    <Resource Include="Assets\RemoteTool.ico" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    <ProjectReference Include="../RemoteTool.Core/RemoteTool.Core.csproj" />
    <ProjectReference Include="../RemoteTool.Capture/RemoteTool.Capture.csproj" />
    <ProjectReference Include="../RemoteTool.Input/RemoteTool.Input.csproj" />
    <ProjectReference Include="../RemoteTool.Video/RemoteTool.Video.csproj" />
    <ProjectReference Include="../RemoteTool.Service/RemoteTool.Service.csproj" />
  </ItemGroup>
</Project>
